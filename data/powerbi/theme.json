{
    "name": "GEID Soft Navy",
    "dataColors": [
        "#1F4E79", "#2E75B6", "#F2C14E", "#7FD1AE",
        "#E4574C", "#7030A0", "#9DC3E6", "#5B7189"
    ],
    "background": "#0F2C52",
    "foreground": "#12305B",
    "tableAccent": "#2E75B6",
    "good": "#2E7D32",
    "bad": "#E4574C",
    "neutral": "#9DC3E6",
    "textClasses": {
        "label": { "color": "#5B7189", "fontSize": 10 },
        "callout": { "color": "#12305B", "fontSize": 26 },
        "title": { "color": "#12305B", "fontSize": 12 },
        "header": { "color": "#12305B", "fontSize": 11 }
    },
    "visualStyles": {
        "*": {
            "*": {
                "background": [ { "show": true, "color": "#FFFFFF", "transparency": 0 } ],
                "border": [ { "show": true, "color": "#D8E1EC", "radius": 14 } ],
                "title": [ { "show": true,
                    "fontColor": { "solid": { "color": "#12305B" } },
                    "fontSize": 12, "fontFamily": "Segoe UI" } ],
                "labels": [ { "color": { "solid": { "color": "#5B7189" } } } ],
                "categoryAxis": [ { "labelColor": { "solid": { "color": "#5B7189" } } } ],
                "valueAxis": [ { "labelColor": { "solid": { "color": "#5B7189" } } } ],
                "legend": [ { "labelColor": { "solid": { "color": "#12305B" } } } ]
            }
        },
        "tableEx": {
            "*": {
                "columnHeaders": [ {
                    "fontColor": { "solid": { "color": "#12305B" } },
                    "backColor": { "solid": { "color": "#EAF0F7" } },
                    "fontSize": 10 } ],
                "values": [ {
                    "fontColor": { "solid": { "color": "#22364E" } },
                    "backColor": { "solid": { "color": "#FFFFFF" } },
                    "fontSize": 10 } ],
                "grid": [ {
                    "gridVertical": false,
                    "gridHorizontal": true,
                    "gridHorizontalColor": { "solid": { "color": "#E3EAF3" } } } ]
            }
        },
        "card": {
            "*": {
                "labels": [ { "color": { "solid": { "color": "#12305B" } } } ],
                "categoryLabels": [ { "color": { "solid": { "color": "#5B7189" } } } ]
            }
        }
    }
}