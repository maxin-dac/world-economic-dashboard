<script>
(function(){
  var TIPS = {"GDP per capita (USD)": "Average economic output per person. Higher = wealthier population.", "Inflation (%)": "Annual percentage change in consumer prices. Moderate (2-3%) is healthy; very high erodes purchasing power.", "Public Debt (% GDP)": "Government debt as a share of GDP. Higher = heavier public debt burden.", "High-income Countries": "Number of high-income countries in the current selection. Click to view the full list.", "Low-income Countries": "Number of low-income countries in the current selection. Click to view the full list."};
  var root = window.parent && window.parent.document;
  if(!root) return;
  var tip = root.getElementById('__kpi_tip__');
  if(!tip){
    tip = root.createElement('div');
    tip.id = '__kpi_tip__';
    tip.style.cssText = 'position:fixed;z-index:2147483647;pointer-events:none;opacity:0;'
      + 'transform:translateY(6px);transition:opacity .14s ease,transform .14s ease;max-width:300px;'
      + 'padding:10px 13px;border-radius:12px;background:rgba(10,22,40,.97);color:#eaf1fb;'
      + 'font:500 12.5px/1.5 Manrope,system-ui,sans-serif;box-shadow:0 12px 34px rgba(0,0,0,.5);'
      + 'border:1px solid rgba(120,170,230,.22);';
    root.body.appendChild(tip);
  }
  function labelOf(card){ var e=card.querySelector('[data-testid="stMetricLabel"]'); return e?e.textContent.trim():''; }
  function textOf(card){ var l=labelOf(card); if(l) return l; return (card.textContent||'').trim(); }
  function helpOf(card){
    var h = card.querySelector('[data-testid="stTooltipIcon"] button')
         || card.querySelector('[data-testid="stTooltipIcon"]')
         || card.querySelector('button');
    if(h){ var a=h.getAttribute('aria-label')||h.getAttribute('title'); if(a) return a; }
    return null;
  }
  function tipFor(card){
    var l = labelOf(card); if(l && TIPS[l]) return TIPS[l];
    var txt = textOf(card);
    for(var k in TIPS){ if(TIPS.hasOwnProperty(k) && k && txt.indexOf(k) !== -1) return TIPS[k]; }
    return helpOf(card);
  }
  function bind(card){
    if(card.__tipbound) return; card.__tipbound = 1;
    card.style.cursor = 'default';
    card.addEventListener('mouseenter', function(){
      var t = tipFor(card);
      if(!t){ tip.style.opacity='0'; tip.style.transform='translateY(6px)'; return; }
      tip.textContent = t; tip.style.opacity='1'; tip.style.transform='translateY(0)';
    });
    card.addEventListener('mousemove', function(e){
      var x = e.clientX + 16, y = e.clientY + 18;
      if(x + 312 > window.innerWidth) x = e.clientX - 312;
      if(y + 120 > window.innerHeight) y = window.innerHeight - 130;
      tip.style.left = x + 'px'; tip.style.top = y + 'px';
    });
    card.addEventListener('mouseleave', function(){ tip.style.opacity='0'; tip.style.transform='translateY(6px)'; });
  }
  function scan(){
    var cards = root.querySelectorAll('[data-testid="stMetric"], [data-testid="stPopoverButton"] button, button[data-testid="stPopoverButton"]');
    for(var i=0;i<cards.length;i++) bind(cards[i]);
  }
  scan();
  new MutationObserver(function(){ scan(); }).observe(root.body, {childList:true, subtree:true});
})();
</script>
